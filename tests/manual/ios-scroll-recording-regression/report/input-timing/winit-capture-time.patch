 use crate::platform_impl::platform::DEVICE_ID;
 use crate::platform_impl::KeyEventExtra;
 use crate::window::{WindowAttributes, WindowId as RootWindowId};
+
+fn touch_timestamp(timestamp: f64) -> Option<Instant> {
+    unsafe extern "C" {
+        fn CACurrentMediaTime() -> f64;
+    }
+    static ORIGIN: OnceLock<(f64, Instant)> = OnceLock::new();
+    let (uptime, instant) =
+        ORIGIN.get_or_init(|| (unsafe { CACurrentMediaTime() }, Instant::now()));
+    let delta = timestamp - uptime;
+    let duration = Duration::try_from_secs_f64(delta.abs()).ok()?;
+    if delta >= 0. {
+        instant.checked_add(duration)
+    } else {
+        instant.checked_sub(duration)
+    }
+}
 
