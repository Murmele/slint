+#[cfg(any(target_os = "ios", test))]
+fn map_touch_timestamp(timestamp: std::time::Instant,
+    origin: (std::time::Instant, corelib::animations::Instant)) -> corelib::animations::Instant {
+    if timestamp >= origin.0 { origin.1 + timestamp.duration_since(origin.0) }
+    else { origin.1 - origin.0.duration_since(timestamp) }
