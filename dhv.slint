component Weather inherits Rectangle {
    in property<WeatherData> data;

    background: {
        if data.classification == Classification.Positive {
            return green;
        } else if data.classification == Classification.Negative {
            return orange;
        } else if data.classification == Classification.Exclamation {
            return yellow;
        }
        return white;
    }

    Vertical {
        Text {
            text: root.data.date;
            font-size: 20pt;
            color: black;
        }

        Text {
            text: root.data.title;
            font-weight: 800;
            color: black;
        }

        Text {
            text: root.data.summary;
            wrap: word-wrap;
            color: black;
        }

        Text {
            text: root.data.description;
            wrap: word-wrap;
            color: black;
        }
    }
}

component LocationWeatherData inherits Rectangle {
    in property<Location> weather_data;

    Vertical {
        location:= Text {
            text: root.weather_data.location;
            color: #3586f4;
            font-size: 40pt;
        }

        for d in weather_data.weather_data: Weather {
            data: d;
        }
    }
}

export component DHV inherits Rectangle {
    preferred-width: 600px;
    preferred-height: 600px;

    Vertical {
        t:= Rectangle {
            text:= Text {
                text: "Data from: " + DHVInterface.weather_data.creation-datetime;
                horizontal-alignment: right;
            }
            background: green;
            // animate background {
            //      duration: 3s;
            // }
        }
        ListView {
            property<length> entry_height: 600px;
            viewport-width: parent.width;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

            for l[i] in  DHVInterface.weather_data.locations: LocationWeatherData {
                x: 0px;
                y: parent.entry_height * i;
                weather_data: l;
            }

            scrolled => {
                debug("Scrolled");
                if t.background == Colors.green {
                    t.background = Colors.red;
                } else {
                    t.background = Colors.green;
                }
            }
        }
    }
}