import {Vertical, ListView} from "ui-libraries/material/src/material.slint";

export enum Classification {
    Positive,
    Negative,
    Neutral,
    Exclamation,
}

export struct WeatherData {
    date: string,
    title: string,
    summary: string,
    description: string,
    classification: Classification,
}

export struct Location {
    location: string,
    weather_data: [WeatherData],
}

export struct Weather {
    creation_datetime: string,
    locations: [Location]
}

