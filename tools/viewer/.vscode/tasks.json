{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cargo",
			"command": "build",
			"problemMatcher": [
				"$rustc"
			],
			"group": {
                "kind": "build",
                "isDefault": true
            },
			"env": {
				"RUSTFLAGS": "--cfg slint_debug_property"
			},
			"label": "rust: cargo build"
		}
	]
}