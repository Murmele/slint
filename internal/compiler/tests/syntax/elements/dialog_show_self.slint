export component SelfShowing inherits Dialog {
    Text { text: "Hello"; }
    init => { root.show-modal(DialogModality.window-modal); }
//                 >        <error{A Dialog cannot show itself, call 'show()' or 'show-modal()' from the component that declares it}
}
