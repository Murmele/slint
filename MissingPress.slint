export component Demo {
    height: 500px;
    VerticalBox {
        MissingPress {}
        MissingPressFocusOnClickFalse {}
        TouchAreaFocusScopeSidebySide {}
        TouchAreaFocusScopeSidebySideFocusOnClickFalse {}
        FocusScopeTouchAreaSidebySide {}
    }
}
