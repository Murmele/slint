import { AboutSlint, Button, VerticalBox } from "std-widgets.slint";

component TextItem inherits VerticalBox {
    spacing: 0px;
    preferred-height: 50px;
    in property <string> title;
    in property <string> error;
    Text {
        vertical-alignment: center;
        horizontal-alignment: center;
        text: title;
    }
    Text {
        vertical-alignment: center;
        horizontal-alignment: center;
        text: error;
    }
}

export component MissingPress inherits Rectangle {
    preferred-width: 400px;
    background: green;

    TextItem {
        title: "MissingPress";
        error: "First touch area event is a release";
    }

    TouchArea {
        FocusScope {
            key-pressed(event) => {
                debug("MissingPress: Key press");
                return reject;
            }
        }

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                debug("MissingPress: Pressed x during Press: ", self.pressed-x);
            } else if event.kind == PointerEventKind.up {
                debug("MissingPress: Pressed x during Release: ", self.pressed-x);
            }
        }
    }
}

export component MissingPressFocusOnClickFalse inherits Rectangle {
    preferred-width: 400px;
    background: yellowgreen;

    TextItem {
        title: "MissingPressFocusOnClickFalse";
        error: "No key press handled";
    }

    TouchArea {
        FocusScope {
            focus-on-click: false;
            key-pressed(event) => {
                debug("MissingPressFocusOnClickFalse: Key press");
                return reject;
            }
        }

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                debug("MissingPressFocusOnClickFalse: Pressed x during Press: ", self.pressed-x);
            } else if event.kind == PointerEventKind.up {
                debug("MissingPressFocusOnClickFalse: Pressed x during Release: ", self.pressed-x);
            }
        }
    }
}

